# Required by all edge functions
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
GDER_PUBLIC_SITE_URL=https://gder.net

# Optional email delivery for submission verification
RESEND_API_KEY=
GDER_INTAKE_EMAIL_FROM=GDER <intake@gder.net>
# Set to true only in non-production testing if you want submit responses to return the raw confirm token
GDER_INTAKE_ALLOW_DEV_EMAIL_CONFIRM_TOKEN=false

# Optional breadcrumb-wallet proof settings
GDER_INTAKE_BREADCRUMB_ADDRESS=0x0000000000000000000000000000000000000000
GDER_INTAKE_WALLET_CHAIN_ID=eip155:1
GDER_INTAKE_WALLET_CHAIN_LABEL=Ethereum mainnet
GDER_INTAKE_EVM_RPC_URL=
